+  --model:#14213D;--market:#2A9D8F;--edge:#F26430;--edge-soft:#FDE4DA;--ok:#2F855A;
+  --display:'Barlow Condensed',system-ui,sans-serif;--body:'IBM Plex Sans',system-ui,sans-serif;--mono:'IBM Plex Mono',monospace;
+}
