+    const st = c.standing ? esc(c.standing.rank)+'ᵉ · '+c.standing.points+' pts en '+c.standing.played+' matchs'+(c.standing.form?' · '+form(c.standing.form):'') : '<span class="empty">classement indisponible</span>';
